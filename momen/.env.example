# Copy to .env and fill in. On Vercel these are set in Project → Settings → Environment Variables
# (DATABASE_URL, DATABASE_URL_UNPOOLED and BLOB_READ_WRITE_TOKEN are added automatically when you
# connect Neon and Blob storage). `vercel env pull .env` downloads them for local use.

# Postgres (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Photo storage. Leave unset to keep photos in ./uploads locally.
# BLOB_READ_WRITE_TOKEN=""

# The password you type to log in.
APP_PASSWORD="change-me"

# Any long random string. Changing it logs you out everywhere.
SESSION_SECRET="replace-with-a-long-random-string"

# Shop timezone and currency.
APP_TIMEZONE="Africa/Lagos"
NEXT_PUBLIC_CURRENCY_SYMBOL="₦"
